{
  "name": "vault-maintenance",
  "version": "1.0.0",
  "description": "Obsidian vault maintenance agent — link integrity, ambiguous links, index staleness",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vault-maintenance": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "setup:launchd": "tsx scripts/setup-launchd.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "commander": "^13.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/USERNAME/vault-maintenance.git"
  },
  "keywords": [
    "obsidian",
    "vault",
    "wiki-links",
    "markdown",
    "cli",
    "link-integrity"
  ]
}